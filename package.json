{
  "name": "mosport-magazine",
  "version": "0.1.0",
  "private": true,
  "description": "MOSPORT-B: MOSPORT sports magazine frontend (static, no build step)",
  "license": "UNLICENSED",
  "scripts": {
    "test": "npm run registry:check && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/run.js",
    "registry:build": "node scripts/build-registry.js",
    "registry:check": "node scripts/build-registry.js --check",
    "setup:browsers": "playwright install chromium",
    "evidence": "node tests/e2e/evidence.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
